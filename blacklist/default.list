# Terra default block list
# Format: Mihomo/Clash rule-provider, behavior: classical, format: text

# PROTOCOL,bittorrent 开不了，需要在 config单独加
# PROTOCOL,bitdhtv2 开不了，需要在 config单独加
# --- RED PORT ---
# FTP / SSH / Telnet / SMTP 等高风险或受管控服务
DST-PORT,21
DST-PORT,23-26

# Remote Mail Checking Protocol
DST-PORT,50

# MTP / 历史邮件传输协议
DST-PORT,57

# TFTP
DST-PORT,69

# Finger
DST-PORT,79

# CSO / CCSO Directory
DST-PORT,105

# 3COM-TSMUX
DST-PORT,106

# POP3
DST-PORT,110

# RPCBind / Portmapper
DST-PORT,111

# Ident
DST-PORT,113

# Microsoft RPC Endpoint Mapper
DST-PORT,135

# NetBIOS
DST-PORT,137-139

# IMAP
DST-PORT,143

# PCMail
DST-PORT,158

# SNMP / SNMP Trap
DST-PORT,161-162

# QMTP
DST-PORT,209

# SLP / Service Location Protocol
DST-PORT,427

# SMB / CIFS
DST-PORT,445

# rexec / rlogin / rsh / Syslog / LPD
DST-PORT,512-515

# AFP / Apple Filing Protocol
DST-PORT,548

# KPOP
DST-PORT,1109

# 非标准 / 自定义服务常用端口
DST-PORT,1337

# BitTorrent 常用端口
DST-PORT,6881-6889

# BitTorrent / P2P Tracker 常用端口
DST-PORT,6969


